# Required for any live Gemini call
GEMINI_API_KEY=

# Model IDs (checked against https://ai.google.dev/gemini-api/docs/models on 2026-10-16)
EXTRACTION_MODEL=gemini-3.8-flash
REASONING_MODEL=gemini-4-argon

# Client-side requests/minute per model. Free tier is ~5; 0 = no throttle (paid tiers).
GEMINI_RPM=5

# local = JSON files + uploads on disk; gcp = Firestore + Cloud Storage
STORAGE_BACKEND=local
LOCAL_DATA_DIR=./data

# Only for STORAGE_BACKEND=gcp
GCP_PROJECT=
GCS_BUCKET=
FIRESTORE_DATABASE=(default)
