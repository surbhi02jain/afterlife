# Required for any live Gemini call
GEMINI_API_KEY=

# Model IDs, checked against the live model list for a billed key on 2026-10-18 (both answered with the app's
# thinking level and JSON-schema settings). gemini-4-argon needs billing (free-tier quota is 0).
# Free tier instead: REASONING_MODEL=gemini-3.6-flash and GEMINI_RPM=5 (two different models = two daily quotas).
EXTRACTION_MODEL=gemini-3.8-flash
REASONING_MODEL=gemini-4-argon

# Client-side requests/minute per model. 0 = no throttle (billed key); ~5 on the free tier.
GEMINI_RPM=0

# Gemini calls per day per instance, a ceiling on the bill (~30 full analyses). 0 = no limit.
GEMINI_DAILY_LIMIT=300

# local = JSON files + uploads on disk; gcp = Firestore + Cloud Storage
STORAGE_BACKEND=local
LOCAL_DATA_DIR=./data

# Only for STORAGE_BACKEND=gcp
GCP_PROJECT=
GCS_BUCKET=
FIRESTORE_DATABASE=(default)
